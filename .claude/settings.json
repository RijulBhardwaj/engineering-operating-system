{
  "model": "claude-opus-5-5",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" session", "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" guard", "timeout": 60 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" post", "timeout": 180 } ] },
      { "matcher": "Bash|PowerShell|mcp__terminal__run_in_terminal", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" postshell", "timeout": 60 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" stop", "timeout": 300 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/factory/hook.mjs\" stop", "timeout": 300 } ] }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/factory/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/agents/**)",
      "Edit(.factory/**)",
      "Edit(.git/**)",
      "Read(**/factory-audit-*.key)"
    ]
  }
}
